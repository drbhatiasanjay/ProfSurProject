{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskContract",
  "description": "Machine-enforceable execution contract for autonomous agents working on ProfSurProject.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "authority",
    "mode",
    "repository",
    "workspace",
    "base_branch",
    "base_sha",
    "worker_branch",
    "authorized_packet",
    "allowed_objectives",
    "forbidden_objectives",
    "allowed_paths",
    "forbidden_paths",
    "required_tests",
    "stop_conditions",
    "maximum_new_commits",
    "push_authorized",
    "pr_creation_authorized",
    "merge_authorized",
    "deployment_authorized",
    "protected_artifacts",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": ["WORKER_IMPLEMENTATION_ONLY", "AUDITOR_INDEPENDENT_REVIEW", "INSPECTION_ONLY"]
    },
    "repository": {
      "type": "string",
      "enum": ["ProfSurProject"]
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "base_branch": {
      "type": "string",
      "minLength": 1
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "worker_branch": {
      "type": "string",
      "minLength": 1
    },
    "authorized_packet": {
      "type": "string",
      "minLength": 1
    },
    "allowed_objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_objectives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "maximum_new_commits": {
      "type": "integer",
      "minimum": 0
    },
    "push_authorized": {
      "type": "boolean"
    },
    "pr_creation_authorized": {
      "type": "boolean"
    },
    "merge_authorized": {
      "type": "boolean"
    },
    "deployment_authorized": {
      "type": "boolean"
    },
    "protected_artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    }
  }
}
